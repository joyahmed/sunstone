# Editors write what git expects (see .gitattributes). VS Code, Zed, JetBrains,
# Neovim (with the editorconfig plugin) all honour this file.
root = true

[*]
end_of_line = lf
charset = utf-8
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.{bat,cmd,reg}]
end_of_line = crlf

# PowerShell reads a BOM-less file with the ANSI codepage: any non-ASCII
# character (an em-dash, an emoji) then breaks the parse. A BOM makes it UTF-8.
[*.{ps1,psm1,psd1}]
charset = utf-8-bom
indent_size = 4
